+    UNI_GAMEPAD_PRESSURE_DPAD_RIGHT,
+    UNI_GAMEPAD_PRESSURE_DPAD_LEFT,
+    UNI_GAMEPAD_PRESSURE_BUTTON_A,
+    UNI_GAMEPAD_PRESSURE_BUTTON_B,
+    UNI_GAMEPAD_PRESSURE_BUTTON_X,
+    UNI_GAMEPAD_PRESSURE_BUTTON_Y,
+    UNI_GAMEPAD_PRESSURE_BUTTON_SHOULDER_L,
+    UNI_GAMEPAD_PRESSURE_BUTTON_SHOULDER_R,
+
+    UNI_GAMEPAD_PRESSURE_COUNT,
+} uni_gamepad_pressure_t;
+
 // DPAD constants.
 enum {
     DPAD_UP = BIT(UNI_GAMEPAD_MAPPINGS_DPAD_UP),
@@ -165,6 +182,11 @@ typedef struct {

     int32_t gyro[3];
     int32_t accel[3];
+
+    // Pressure of the D-pad, A/B/X/Y and shoulder buttons, 0-255, by uni_gamepad_pressure_t.
